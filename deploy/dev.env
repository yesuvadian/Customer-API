# Values that differ between environments per deploy.ps1's dev branch.
# This is the SAFE DEFAULT — docker-compose.yml falls back to these exact
# values even if you don't pass --env-file at all.
#
# DB_HOST is deliberately host.docker.internal, not deploy.ps1's literal
# "localhost" — deploy.ps1 runs directly ON the dev VM where Postgres also
# runs, so "localhost" is correct there. A container needs the Docker
# Desktop/Linux host-gateway name instead to reach that same "local to the
# VM" Postgres from inside its own network namespace (see
# docker-compose.yml's extra_hosts).
DB_HOST=host.docker.internal
DB_PORT=5432
BASE_URL=https://devsupplier.cogniwatt.com
