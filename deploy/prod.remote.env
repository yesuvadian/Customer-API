# Overrides on top of prod.env, only for deploy-docker.ps1's remote deploy
# to the Primary/DR servers — NOT for local Windows testing.
#
# Verified free via `ss -tlnp` on both 192.168.0.105 (Primary) and
# 192.168.0.100 (DR) — only 8000 is taken on either (the bare-metal
# api-procurement service's worker processes).
API_HOST_PORT=8001

# Same reasoning as dev.remote.env: the end user's browser is on a
# different machine than the server, so "localhost" would resolve wrong.
# This points at Primary's own IP + port directly; consider replacing with
# a proper domain (matching deploy.ps1's BASE_URL scheme) once this Docker
# path is actually promoted to real use.
UI_API_BASE_URL=http://192.168.0.105:8001

# Same reasoning as dev.remote.env: keeps this off the real Relu_Vendor2
# so the container's scheduler can't double-fire against production data
# alongside the bare-metal service. UNVERIFIED — Relu_Vendor2_docker does
# not exist on the Patroni primary yet; it must be cloned there (same
# steps as dev.remote.env's, run against 192.168.0.105/192.168.0.162)
# before this file is usable.
DB_USER=relu_user
DB_PASSWORD=StrongPassword123!
DB_NAME=Relu_Vendor2_docker
