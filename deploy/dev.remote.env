# Overrides on top of dev.env, only for deploy-docker.ps1's remote deploy
# to the dev VM (192.168.0.109) — NOT for local Windows testing.
#
# Port 8000 on that VM is already bound by the existing bare-metal
# customer-api service (confirmed via `ss -tlnp`, pid=1043). 8001 is free.
API_HOST_PORT=8001

# The end user's browser is on a different machine than the VM, so
# "localhost" (docker-compose.yml's local-testing default) would resolve
# to their own machine instead. Points directly at the VM's IP + the
# remapped port above until a proper domain/nginx reverse-proxy rule
# exists for this Docker deployment.
UI_API_BASE_URL=http://192.168.0.109:8001

# Deliberately NOT the same DB as the bare-metal customer-api service.
# Both would run APScheduler (ENABLE_SCHEDULER=true) independently, so
# sharing Relu_Vendor2 would double-fire scheduled reports/notifications.
# Relu_Vendor2_docker is a clone, used only by this container — see
# deploy-docker.ps1's usage notes for the one-time clone + pg_hba.conf
# setup this requires on the VM before the first Docker deploy.
# DB_USER/DB_PASSWORD match deploy.ps1's dev branch (relu_user has access
# to both databases once the clone is created with the same owner).
DB_USER=relu_user
DB_PASSWORD=StrongPassword123!
DB_NAME=Relu_Vendor2_docker
