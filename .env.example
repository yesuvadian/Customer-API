# ============================================================
# CogniWatt Customer API - Environment Configuration Template
# ============================================================
# Copy this file to .env and update with your actual values

# ============================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_PORT=5432
DB_NAME=cogniwatt_db

# ============================================================
# APPLICATION SETTINGS
# ============================================================
APP_NAME=CogniWatt-Customer-API
ENV=development
BASE_URL=http://localhost:8000

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================
# Generate a secure random key: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_change_this_in_production
ALGORITHM=HS256

# Token expiration times
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_EXPIRY_DAYS=20
RESETPASSWORD_TOKEN_EXPIRE=300

# Login security
MAX_LOGIN_ATTEMPTS=5
MAX_OTP_ATTEMPTS=3
TOTP_INTERVAL=180

# ============================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com

# ============================================================
# REDIS CONFIGURATION (Optional - for caching)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5

# ============================================================
# ZOHO INTEGRATION (Optional)
# ============================================================
ZOHO_WEBHOOK_SECRET=your_webhook_secret
ZOHO_DASHBOARD_CACHE_TTL=300

# ============================================================
# VENDOR APP INTEGRATION (Optional)
# ============================================================
VENDOR_APP_URL=http://localhost:9000
INTERNAL_SERVICE_SECRET=your_service_secret

# ============================================================
# EXTERNAL SERVICES
# ============================================================
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse

# ============================================================
# NOTES:
# ============================================================
# 1. Never commit .env file to Git (already in .gitignore)
# 2. Use strong passwords in production
# 3. Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
# 4. For Gmail SMTP, use App Password (not regular password)
# 5. MongoDB is optional - API will work without it
