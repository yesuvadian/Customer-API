# ============================================================
# CogniWatt Customer API - Environment Configuration Template
# ============================================================
# Copy this file to .env and update with your actual values

# ============================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_PORT=5432
DB_NAME=cogniwatt_db

# ============================================================
# APPLICATION SETTINGS
# ============================================================
APP_NAME=CogniWatt-Customer-API
ENV=development
BASE_URL=http://localhost:8000

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================
# Generate a secure random key: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_change_this_in_production
ALGORITHM=HS256

# Token expiration times
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_EXPIRY_DAYS=20
RESETPASSWORD_TOKEN_EXPIRE=300

# Login security
MAX_LOGIN_ATTEMPTS=5
MAX_OTP_ATTEMPTS=3
TOTP_INTERVAL=180

# ============================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com

# ============================================================
# REDIS CONFIGURATION (Optional - for caching)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5

# ============================================================
# ZOHO INTEGRATION (Optional)
# ============================================================
ZOHO_WEBHOOK_SECRET=your_webhook_secret
ZOHO_DASHBOARD_CACHE_TTL=300

# ============================================================
# VENDOR APP INTEGRATION (Optional)
# ============================================================
VENDOR_APP_URL=http://localhost:9000
INTERNAL_SERVICE_SECRET=your_service_secret

# ============================================================
# EXTERNAL SERVICES
# ============================================================
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse

# ============================================================
# NOTIFICATION ENGINE
# ============================================================
NOTIF_DIGEST_THRESHOLD=10
NOTIF_DIGEST_WINDOW_MINUTES=5
NOTIF_MAX_RETRIES=3
NOTIF_RETRY_DELAY_MINUTES=5

# ============================================================
# SMS CONFIGURATION
# ============================================================
# Gateway selector: twilio | msg91 | http | none  (default: none = disabled)
# Set SMS_PROVIDER to activate a gateway; leave as "none" to skip all SMS.
SMS_PROVIDER=none
SMS_FROM_NUMBER=

# ── Twilio  (SMS_PROVIDER=twilio) ──────────────────────────
# Credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# ── MSG91 — India DLT transactional SMS  (SMS_PROVIDER=msg91) ──
# Route 4 (Transactional).  MSG91_TEMPLATE_ID is your TRAI-registered DLT_TE_ID.
# Sender ID must match your DLT-approved sender ID (6 chars, uppercase).
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_template_id
MSG91_SENDER_ID=SEACMS

# ── Generic HTTP gateway  (SMS_PROVIDER=http) ──────────────
# Sends: POST <SMS_HTTP_URL>  JSON body: {"to":"+91...","from":"...","body":"..."}
SMS_HTTP_URL=https://your-sms-gateway.example.com/send
SMS_HTTP_AUTH_HEADER=Authorization
SMS_HTTP_AUTH_VALUE=Bearer your_token_here

# ============================================================
# PREDICTIVE ANALYTICS / TREND ENGINE TUNING
# ============================================================
# services/analytics_engine.py + routers/analytics.py — config.py has the
# full explanation of each. Safe to omit any of these; each falls back to
# the default value shown below.
ANALYTICS_MIN_TREND_POINTS=1
ANALYTICS_STABLE_FRACTION=0.05
ANALYTICS_ANOMALY_Z=3.0
# Minimum regression r² before a trend's direction (and any breach
# forecast built from its slope) is trusted at all — a poor-fit slope
# falls back to "Stable" regardless of how large it looks.
ANALYTICS_MIN_TREND_R_SQUARED=0.5
# Deterioration Watch List: minimum ParameterAnalytics history_count
# before a parameter with no ParameterThresholdBand config is trusted
# enough to surface there at all.
ANALYTICS_MIN_WATCH_HISTORY=4

# ============================================================
# NOTES:
# ============================================================
# 1. Never commit .env file to Git (already in .gitignore)
# 2. Use strong passwords in production
# 3. Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
# 4. For Gmail SMTP, use App Password (not regular password)
# 5. MongoDB is optional - API will work without it
# 6. For Indian SMS (MSG91), obtain DLT registration from TRAI-approved platform
#    before sending transactional SMS — unregistered messages are rejected by carriers
