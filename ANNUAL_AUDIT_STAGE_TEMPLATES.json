  "audit_obs_reporting_electrical_safety": {
    "name": "Observation Reporting — Electrical Safety",
    "template_type": "audit_stage",
    "sections": [
      {
        "title": "Observation Details",
        "fields": [
          {"key": "observation_location", "label": "Location / Panel / Area", "type": "text", "required": true},
          {"key": "observation_description", "label": "Observation Description", "type": "textarea", "required": true},
