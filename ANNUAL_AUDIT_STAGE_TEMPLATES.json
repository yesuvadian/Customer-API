        "fields": [
          {"key": "es_earthing_condition", "label": "Earthing Condition", "type": "dropdown", "required": true, "options": ["Good", "Damaged", "Corroded", "Not Tested"]},
          {"key": "es_earthing_resistance", "label": "Earthing Resistance (ohms)", "type": "number", "required": false},
          {"key": "es_danger_board_available", "label": "Danger Board Available", "type": "boolean", "required": false},
          {"key": "es_shock_hazard_observed", "label": "Shock Hazard Observed", "type": "boolean", "required": false},
          {"key": "es_relay_calibration_status", "label": "Protection Relay Calibration Status", "type": "dropdown", "required": false, "options": ["Current", "Overdue", "Not Available"]},
          {"key": "es_remarks", "label": "Additional Remarks", "type": "textarea", "required": false}
        ]
      },
      {
        "title": "Assessment",
        "fields": [
          {"key": "overall_result", "label": "Assessment Result", "type": "dropdown", "required": true, "options": ["Non-Compliant", "Conditional", "Compliant"]},
          {"key": "inspector_remarks", "label": "Inspector Remarks", "type": "textarea", "required": false}
        ]
      }
    ]
  },

