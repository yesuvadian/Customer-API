# ================================
# SMS Configuration
# ================================
# Gateway selector: twilio | msg91 | http | none  (default: none = disabled)
SMS_PROVIDER=none
SMS_FROM_NUMBER=

# Twilio  (SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# MSG91 — India DLT transactional SMS  (SMS_PROVIDER=msg91)
# Route 4 (Transactional); DLT_TE_ID sent automatically when MSG91_TEMPLATE_ID is set
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SEACMS

# Generic HTTP gateway  (SMS_PROVIDER=http)
# Sends: POST <SMS_HTTP_URL>  body: {"to": "+91...", "from": "...", "body": "..."}
SMS_HTTP_URL=
SMS_HTTP_AUTH_HEADER=Authorization
SMS_HTTP_AUTH_VALUE=

TR_PAGE_SIZE=100
EQUIPMENT_PAGE_SIZE=20

